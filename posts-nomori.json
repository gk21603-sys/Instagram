[{"account": "hibanomori", "publish_at": "2026-08-18T12:00:00+09:00", "type": "image", "pillar": "A", "images": ["images/2026-08/nomori-01-soap.jpg"], "caption": "無添加の石けん。\n\n青森ヒバ油を配合し、香料も着色料も入れていません。泡立ちや香りの持ちは、足し算では作っていません。\n\nヒバ材の皿にのせ、水を切って置くだけで長く使えます。\n\nオンラインストアは8月下旬公開予定です。", "hashtags": ["#青森ヒバ", "#ひばの森", "#ヒバ石けん", "#無添加石けん", "#石けん", "#大間"], "status": "approved"}, {"account": "hibanomori", "publish_at": "2026-08-20T12:00:00+09:00", "type": "image", "pillar": "C", "images": ["images/2026-08/nomori-02-lighthouse.jpg"], "caption": "津軽海峡、対岸は北海道。\n\n大間の沖に浮かぶ弁天島。この海峡から吹く風と海霧が、青森ヒバの育つ環境をつくっています。\n\n1988年から、この土地で蒸留を続けています。\n\n香りでつながる、ひばの森。", "hashtags": ["#青森ヒバ", "#大間", "#津軽海峡", "#下北半島", "#ひばの森", "#青森"], "status": "approved"}, {"account": "hibanomori", "publish_at": "2026-08-22T12:00:00+09:00", "type": "image", "pillar": "B", "images": ["images/2026-08/nomori-03-workbench.jpg"], "caption": "作業台の上で、完結する。\n\n材を扱い、詰めて、検品する。工程はすべて同じ建物の中にあります。\n\n何千本も流れるラインではないので、一本ずつ人の手が触ります。\n\n香りでつながる、ひばの森。", "hashtags": ["#青森ヒバ", "#ものづくり", "#手仕事", "#大間", "#ひばの森"], "status": "approved"}, {"account": "hibanomori", "publish_at": "2026-08-25T12:00:00+09:00", "type": "image", "pillar": "D", "images": ["images/2026-08/nomori-04-leaf.jpg"], "caption": "鱗片が重なる、ヒバの葉。\n\n青森ヒバの香りをつくる成分のひとつ、ヒノキチオール。名前にヒノキとありますが、日本のヒノキにはほとんど含まれていません。\n\n古くからタンスや長持の材として着物を守り、社寺仏閣の建材に選ばれてきたのは、この香り成分が防虫・防腐に役立つとされてきたためです。\n\n香りでつながる、ひばの森。", "hashtags": ["#青森ヒバ", "#ヒノキチオール", "#ヒバの葉", "#ひばの森", "#ヒバ材"], "status": "approved"}, {"account": "hibanomori", "publish_at": "2026-08-27T12:00:00+09:00", "type": "image", "pillar": "C", "images": ["images/2026-08/nomori-05-pier.jpg"], "caption": "大間の岸壁、昼。\n\n漁を終えた時間の港です。ここから車で数分の場所に蒸留所があります。\n\n海と森が近い土地で、原料も製造もこの町で完結します。\n\n香りでつながる、ひばの森。", "hashtags": ["#青森ヒバ", "#大間", "#下北半島", "#ひばの森", "#青森"], "status": "approved"}, {"account": "hibanomori", "publish_at": "2026-08-29T12:00:00+09:00", "type": "image", "pillar": "A", "images": ["images/2026-08/nomori-06-oil.jpg"], "caption": "青森ヒバ精油。\n\n原料は青森ヒバだけ。蒸留は大間の蒸留所で行っています。\n\n2009年に特許認定を受けた技術を継承しています。\n\nオンラインストアは8月下旬公開予定です。", "hashtags": ["#青森ヒバ", "#青森ヒバ精油", "#ヒバ油", "#ひばの森", "#大間", "#精油"], "status": "approved"}]
